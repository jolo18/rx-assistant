# ──────────────────────────────────────────────────────────────────────────────
# rx-assistant — backend environment
#
# Copy to backend/.env and fill in. `.env` is gitignored. Bun auto-loads .env
# from the working directory at startup; docker-compose's `env_file` directive
# loads the same file inside the backend container.
#
# Each variable below is annotated:
#   [REQUIRED]  — boot fails / requests fail without it
#   [SECRET]    — sensitive; never commit a real value
#   [DEFAULT]   — has a sensible default; only set to override
# ──────────────────────────────────────────────────────────────────────────────


# [REQUIRED] [SECRET]
# OpenRouter API key — https://openrouter.ai/keys.
# Without this, every POST /api/chat fails with `UPSTREAM_ERROR`. The backend
# itself still boots and serves /health, so compose's healthcheck stays green
# (intentional — we don't want the container restart-looping over a missing
# secret).
OPENROUTER_API_KEY=


# [DEFAULT: anthropic/claude-sonnet-4.6]
# Must be one of the ids registered in `src/lib/pricing.ts`. Boot fails fast
# (UnknownModelError) for unknown ids — the registry is the source of truth.
# Currently registered:
#   anthropic/claude-sonnet-4.6 | anthropic/claude-sonnet-4.5 | anthropic/claude-haiku-4.5
#   deepseek/deepseek-chat | deepseek/deepseek-chat-v3.1 | deepseek/deepseek-v3.1-terminus
#   deepseek/deepseek-v3.2 | deepseek/deepseek-v3.2-exp
#   deepseek/deepseek-v4-flash | deepseek/deepseek-v4-pro | deepseek/deepseek-r1
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6


# [DEFAULT: 60000]  Whole-stream upstream timeout (ms). Independent of TOOL_TIMEOUT_MS.
AI_TIMEOUT_MS=60000


# [DEFAULT: 5000]   Per-tool execute() timeout (ms).
TOOL_TIMEOUT_MS=5000


# [DEFAULT: 8]      Max agent loop iterations. Caps `stopWhen: stepCountIs(N)`.
MAX_AGENT_STEPS=8


# [DEFAULT: ./data/app.db on host; /data/app.db in container]
# Plain filesystem path consumed by bun:sqlite (no `file:` prefix). Docker
# compose overrides this to /data/app.db so the named volume backs it.
DATABASE_PATH=./data/app.db


# [DEFAULT: 8787]   HTTP port the server binds.
PORT=8787


# [DEFAULT: info]   pino log level: silent | fatal | error | warn | info | debug | trace
LOG_LEVEL=info


# [DEFAULT: false]
# When true, attach pino-pretty as a transport for human-readable output.
# Production should leave this false (structured JSON to stdout). Use the
# `bun run dev:pretty` script for local development instead.
LOG_PRETTY=false


# [DEFAULT: *]
# CORS origins. '*' is fine for local dev. For prod, comma-separated list:
#   CORS_ORIGINS=https://app.example.com,https://staging.example.com
CORS_ORIGINS=*
