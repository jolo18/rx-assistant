{
  "name": "rx-assistant-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "dev:pretty": "bun run --hot src/index.ts | bun x pino-pretty -c -t HH:MM:ss.l --ignore pid,hostname --singleLine",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "migrate": "bun run src/db/migrate.ts"
  },
  "dependencies": {
    "@openrouter/ai-sdk-provider": "^2.9.0",
    "ai": "^6.0.175",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.18",
    "pino": "^9.5.0",
    "ulid": "^3.0.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "typescript": "^5.7.3"
  }
}
